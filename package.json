{
  "name": "autoglot",
  "version": "0.3.0",
  "description": "AI-powered i18n translation bot. Diff your en.json on every push, translate only what changed, commit the JSON files back. MIT alternative to Languine, Lokalise, and Crowdin.",
  "type": "module",
  "bin": {
    "autoglot": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "translate": "node bin/translate.mjs",
    "test": "node --test tests/helpers.test.mjs tests/detect.test.mjs tests/templates.test.mjs tests/extract.test.mjs tests/pm.test.mjs tests/init-args.test.mjs"
  },
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translation",
    "auto-translate",
    "automatic-translation",
    "ai-translation",
    "anthropic",
    "claude",
    "claude-haiku",
    "claude-sonnet",
    "github-action",
    "github-actions",
    "ci",
    "cli",
    "developer-tools",
    "devtools",
    "automation",
    "next-intl",
    "react-i18next",
    "vue-i18n",
    "i18next",
    "languine",
    "languine-alternative",
    "lokalise-alternative",
    "crowdin-alternative",
    "phrase-alternative",
    "transifex-alternative",
    "translate-json",
    "json-translation",
    "messages",
    "locale",
    "locales",
    "multilingual",
    "open-source",
    "mit"
  ],
  "homepage": "https://github.com/ffcabbar/autoglot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffcabbar/autoglot.git"
  },
  "bugs": {
    "url": "https://github.com/ffcabbar/autoglot/issues"
  },
  "author": "ffcabbar",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
